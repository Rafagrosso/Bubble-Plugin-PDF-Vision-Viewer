{
    "add_hover_pressed": true,
    "add_is_visible": true,
    "add_large_file_upload_properties": false,
    "can_fit_height": true,
    "can_fit_width": true,
    "category": "visual elements",
    "default_dim": {
        "height": 400,
        "width": 600
    },
    "display": "Excel View",
    "events": {
        "ADN": {
            "caption": "Spreadsheet is loaded",
            "doc": "O documento terminou de carregar",
            "name": "spreadsheet_loaded"
        },
        "ADO": {
            "caption": "Spreadsheet failed to load",
            "doc": "A URL não pôde ser carregada (consulte Error Message)",
            "name": "spreadsheet_error"
        },
        "ADP": {
            "caption": "Page changed",
            "doc": "A planilha (aba) visível mudou",
            "name": "page_changed"
        },
        "ADQ": {
            "caption": "Search completed",
            "doc": "Uma busca terminou (consulte Search Results Count)",
            "name": "search_completed"
        },
        "ADR": {
            "caption": "Download started",
            "doc": "Download iniciado (botão da toolbar ou qualquer ação que baixa arquivo)",
            "name": "download_started"
        },
        "ADS": {
            "caption": "Print started",
            "doc": "Impressão iniciada (botão ou ação)",
            "name": "print_started"
        }
    },
    "fields": {
