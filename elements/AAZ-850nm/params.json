{
    "add_is_visible": true,
    "add_large_file_upload_properties": false,
    "category": "visual elements",
    "default_dim": {
        "height": 400,
        "width": 600
    },
    "display": "Pdf View",
    "fields": {
        "AAE": {
            "caption": "PDF Url",
            "default_val": "",
            "doc": "URL of the PDF to render. Accepts https://, http:// and Bubble file URLs starting with //",
            "editor": "DynamicValue",
            "name": "pdf_url",
            "rank": 1,
            "value": "file"
        },
        "AAF": {
            "caption": "pdf viewer ID",
            "doc": "(Optional) Legacy identifier, kept for backward compatibility. No longer required.",
            "editor": "DynamicValue",
            "name": "pdf_viewer_id",
            "optional": true,
            "rank": 2,
            "value": "text"
        },
        "AAG": {
            "caption": "Page to Fit",
            "default_val": false,
            "doc": "(Legacy) Start with the whole page fitted in the viewer. Prefer the 'Initial Zoom' property.",
            "editor": "DynamicValue",
            "name": "page_to_fit",
            "rank": 5,
            "value": "boolean"
        },
        "AAH": {
            "caption": "Remove Download",
            "default_val": false,
            "doc": "Hides the download button. Note: this hides UI only, it does not protect the file itself.",
            "editor": "DynamicValue",
            "name": "remove_download",
            "options": "",
            "rank": 6,
            "value": "boolean"
        },
        "AAI": {
            "caption": "Remove Print",
            "default_val": false,
            "editor": "DynamicValue",
            "name": "remove_print",
            "rank": 8,
            "value": "boolean"
        },
        "AAJ": {
            "caption": "Remove Search",
            "default_val": false,
            "editor": "DynamicValue",
            "name": "remove_search",
            "rank": 9,
            "value": "boolean"
        },
        "AAK": {
            "caption": "Remove Left Toggle",
            "default_val": false,
            "doc": "Hides the sidebar (thumbnails/bookmarks) toggle button.",
            "editor": "DynamicValue",
            "name": "remove_left_toggle",
            "rank": 11,
            "value": "boolean"
        },
        "AAL": {
            "caption": "Remove Presentation Mode",
            "default_val": false,
            "editor": "DynamicValue",
            "name": "remove_presentation_mode",
            "rank": 10,
            "value": "boolean"
        },
        "AAM": {
            "caption": "Remove Bookmark",
            "default_val": false,
            "doc": "Hides the bookmarks (document outline) tab in the sidebar.",
            "editor": "DynamicValue",
            "name": "remove_bookmark",
            "rank": 12,
            "value": "boolean"
        },
        "AAN": {
            "caption": "Remove Top Toolbar",
            "default_val": false,
            "editor": "DynamicValue",
            "name": "remove_top_toolbar",
            "rank": 13,
            "value": "boolean"
        },
        "AAO": {
            "caption": "Remove File Open",
            "default_val": false,
            "doc": "(Deprecated) The new viewer has no file-open button; kept for backward compatibility.",
            "editor": "DynamicValue",
            "name": "remove_file_open",
            "options": "",
            "rank": 14,
            "value": "boolean"
        },
        "AAP": {
            "caption": "Remove Right toggle",
            "default_val": false,
            "doc": "(Deprecated) The new viewer has no right panel; kept for backward compatibility.",
            "editor": "DynamicValue",
            "name": "remove_right_toggle",
            "rank": 15,
            "value": "boolean"
        },
        "AAQ": {
            "caption": "Starting Page Number",
            "default_val": 1,
            "editor": "DynamicValue",
            "name": "start_page",
            "rank": 3,
            "value": "number"
        },
        "AAR": {
            "caption": "Viewer Language",
            "default_val": "auto",
            "doc": "UI language: auto (browser language), en, pt, fr, es or de.",
            "editor": "DynamicValue",
            "in_style": false,
            "name": "viewer_language",
            "optional": true,
            "options": "",
            "rank": 4,
            "value": "text"
        },
        "AAS": {
            "caption": "Rename Download File",
            "default_val": "",
            "doc": "If set, downloads use this file name (include the .pdf extension, e.g. document.pdf).",
            "editor": "DynamicValue",
            "name": "rename_download_file",
            "optional": true,
            "rank": 7,
            "value": "text"
        },
        "AAT": {
            "caption": "Search Word",
            "doc": "Term searched (and highlighted) automatically after the PDF loads. Can be changed dynamically.",
            "editor": "DynamicValue",
            "long_text": true,
            "name": "search_word",
            "optional": true,
            "rank": 16,
            "value": "text"
        },
        "AAU": {
            "caption": "App Name",
            "doc": "(Optional) Your Bubble app name; used to normalize *.cdn.bubble.io file URLs.",
            "editor": "DynamicValue",
            "name": "app_name",
            "optional": true,
            "rank": 0,
            "value": "text"
        },
        "AAV": {
            "caption": "Background Color",
            "default_val": "rgba(42, 42, 46, 1)",
            "doc": "Viewer background color.",
            "editor": "Color",
            "in_style": false,
            "name": "background_color",
            "rank": 17
        },
        "AAW": {
            "caption": "Text Color",
            "default_val": "rgba(245, 245, 245, 1)",
            "doc": "Toolbar/UI text color.",
            "editor": "Color",
            "name": "text_color",
            "rank": 18
        },
        "ABA": {
            "caption": "Show Thumbnails Panel",
            "default_val": false,
            "doc": "Opens the thumbnails sidebar when the viewer loads.",
            "editor": "DynamicValue",
            "name": "show_thumbnails",
            "rank": 19,
            "value": "boolean"
        },
        "ABB": {
            "caption": "Protected Mode",
            "default_val": false,
            "doc": "Hides download/print, disables right-click, text selection and Ctrl/Cmd+S/P/C inside the viewer. Note: no client-side protection is absolute.",
            "editor": "DynamicValue",
            "name": "protected_mode",
            "rank": 20,
            "value": "boolean"
        },
        "ABC": {
            "caption": "Watermark Text",
            "doc": "Dynamic diagonal watermark repeated over the pages (e.g. Current User's email). Leave empty for none.",
            "editor": "DynamicValue",
            "name": "watermark_text",
            "optional": true,
            "rank": 21,
            "value": "text"
        },
        "ABD": {
            "caption": "Watermark Opacity",
            "default_val": 0.14,
            "doc": "Watermark opacity between 0 and 1.",
            "editor": "DynamicValue",
            "name": "watermark_opacity",
            "optional": true,
            "rank": 22,
            "value": "number"
        },
        "ABE": {
            "caption": "Theme",
            "default_val": "dark",
            "doc": "Base color theme of the viewer chrome. Custom colors below override it.",
            "editor": "Dropdown",
            "name": "theme",
            "options": "dark,light",
            "rank": 23
        },
        "ABF": {
            "caption": "Accent Color",
            "default_val": "rgba(59, 130, 246, 1)",
            "doc": "Color used for active controls and search highlights.",
            "editor": "Color",
            "name": "accent_color",
            "rank": 24
        },
        "ABG": {
            "caption": "Initial Zoom",
            "default_val": "auto",
            "doc": "Zoom applied when the document loads. 'auto' fits the page width.",
            "editor": "Dropdown",
            "name": "initial_zoom",
            "options": "auto,page-width,page-fit,50,75,100,125,150,200",
            "rank": 25
        }
    },
    "actions": {
        "ABU": {
            "caption": "Go to page",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.goToPage(properties.page);\n}"
            },
            "fields": {
                "ACP": {
                    "caption": "Page number",
                    "name": "page",
                    "value": "number",
                    "rank": 0,
                    "editor": "DynamicValue"
                }
            }
        },
        "ABV": {
            "caption": "Next page",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.nextPage();\n}"
            }
        },
        "ABW": {
            "caption": "Previous page",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.prevPage();\n}"
            }
        },
        "ABX": {
            "caption": "Zoom in",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.zoomIn();\n}"
            }
        },
        "ABY": {
            "caption": "Zoom out",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.zoomOut();\n}"
            }
        },
        "ABZ": {
            "caption": "Set zoom (%)",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.setZoom(properties.zoom_percent);\n}"
            },
            "fields": {
                "ACQ": {
                    "caption": "Zoom percent",
                    "name": "zoom_percent",
                    "value": "number",
                    "rank": 0,
                    "editor": "DynamicValue",
                    "doc": "e.g. 100 for 100%"
                }
            }
        },
        "ACA": {
            "caption": "Fit to page",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.fitPage();\n}"
            }
        },
        "ACB": {
            "caption": "Fit to width",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.fitWidth();\n}"
            }
        },
        "ACC": {
            "caption": "Search text",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.search(properties.term);\n}"
            },
            "fields": {
                "ACR": {
                    "caption": "Term",
                    "name": "term",
                    "value": "text",
                    "rank": 0,
                    "editor": "DynamicValue"
                }
            }
        },
        "ACD": {
            "caption": "Clear search",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.clearSearch();\n}"
            }
        },
        "ACE": {
            "caption": "Next search result",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.nextMatch();\n}"
            }
        },
        "ACF": {
            "caption": "Previous search result",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.prevMatch();\n}"
            }
        },
        "ACG": {
            "caption": "Download PDF",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.download(properties.filename);\n}"
            },
            "fields": {
                "ACS": {
                    "caption": "File name",
                    "name": "filename",
                    "value": "text",
                    "rank": 0,
                    "editor": "DynamicValue",
                    "optional": true,
                    "doc": "Include the .pdf extension. Falls back to Rename Download File / original name."
                }
            }
        },
        "ACH": {
            "caption": "Print PDF",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.print();\n}"
            }
        },
        "ACI": {
            "caption": "Rotate",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.rotate(properties.direction);\n}"
            },
            "fields": {
                "ACT": {
                    "caption": "Direction",
                    "name": "direction",
                    "rank": 0,
                    "editor": "Dropdown",
                    "options": "clockwise,counterclockwise",
                    "default_val": "clockwise"
                }
            }
        },
        "ACJ": {
            "caption": "Toggle thumbnails panel",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.toggleSidebar();\n}"
            }
        },
        "ACK": {
            "caption": "Presentation mode (fullscreen)",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.fullscreen();\n}"
            }
        },
        "ACL": {
            "caption": "Extract pages & download",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.extractPages(properties.pages_range, properties.filename);\n}"
            },
            "fields": {
                "ACU": {
                    "caption": "Pages (e.g. 1-3,5)",
                    "name": "pages_range",
                    "value": "text",
                    "rank": 0,
                    "editor": "DynamicValue"
                },
                "ACV": {
                    "caption": "File name",
                    "name": "filename",
                    "value": "text",
                    "rank": 1,
                    "editor": "DynamicValue",
                    "optional": true
                }
            }
        },
        "ACM": {
            "caption": "Merge PDFs & download",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.mergePdfs(properties.pdf_urls, properties.filename);\n}"
            },
            "fields": {
                "ACW": {
                    "caption": "PDF URLs (comma or line separated)",
                    "name": "pdf_urls",
                    "value": "text",
                    "rank": 0,
                    "editor": "DynamicValue",
                    "long_text": true
                },
                "ACX": {
                    "caption": "File name",
                    "name": "filename",
                    "value": "text",
                    "rank": 1,
                    "editor": "DynamicValue",
                    "optional": true
                }
            }
        },
        "ACN": {
            "caption": "Fill PDF form & download",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.fillForm(properties.form_data, properties.filename, properties.flatten);\n}"
            },
            "fields": {
                "ACY": {
                    "caption": "Form data (JSON)",
                    "name": "form_data",
                    "value": "text",
                    "rank": 0,
                    "editor": "DynamicValue",
                    "long_text": true,
                    "doc": "JSON object mapping field names to values, e.g. {\"name\":\"Ana\",\"accept\":true}"
                },
                "ACZ": {
                    "caption": "File name",
                    "name": "filename",
                    "value": "text",
                    "rank": 1,
                    "editor": "DynamicValue",
                    "optional": true
                },
                "ADA": {
                    "caption": "Flatten (make read-only)",
                    "name": "flatten",
                    "value": "boolean",
                    "rank": 2,
                    "editor": "DynamicValue",
                    "default_val": false
                }
            }
        },
        "ACO": {
            "caption": "Stamp image on page & download",
            "code": {
                "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.stampImage(properties.image_url, properties.page, properties.x_percent, properties.y_percent, properties.width_percent, properties.filename);\n}"
            },
            "fields": {
                "ADB": {
                    "caption": "Image URL (PNG/JPG)",
                    "name": "image_url",
                    "value": "text",
                    "rank": 0,
                    "editor": "DynamicValue",
                    "doc": "e.g. a signature image"
                },
                "ADC": {
                    "caption": "Page number",
                    "name": "page",
                    "value": "number",
                    "rank": 1,
                    "editor": "DynamicValue",
                    "default_val": 1
                },
                "ADD": {
                    "caption": "X position (% from left)",
                    "name": "x_percent",
                    "value": "number",
                    "rank": 2,
                    "editor": "DynamicValue",
                    "default_val": 60
                },
                "ADE": {
                    "caption": "Y position (% from top)",
                    "name": "y_percent",
                    "value": "number",
                    "rank": 3,
                    "editor": "DynamicValue",
                    "default_val": 80
                },
                "ADF": {
                    "caption": "Width (% of page width)",
                    "name": "width_percent",
                    "value": "number",
                    "rank": 4,
                    "editor": "DynamicValue",
                    "default_val": 20
                },
                "ADG": {
                    "caption": "File name",
                    "name": "filename",
                    "value": "text",
                    "rank": 5,
                    "editor": "DynamicValue",
                    "optional": true
                }
            }
        }
    },
    "has_reset_fn": true,
    "icon": "ion-eye",
    "property_applications": {
        "BoxShadow": true,
        "MinWidth": true,
        "resizable": true
    },
    "states": {
        "AAX": {
            "caption": "Is Valid PDF?",
            "doc": "true when the current URL was loaded as a valid PDF",
            "initialization_code": {
                "fn": "function(properties, context) {\n\n\n\n}"
            },
            "name": "is_valid_pdf",
            "value": "boolean"
        },
        "AAY": {
            "caption": "Total Pdf Pages",
            "doc": "Number of pages of the loaded PDF",
            "initialization_code": {
                "fn": "function(properties, context) {\n\n\n\n}"
            },
            "name": "total_pages",
            "value": "number"
        },
        "ABH": {
            "caption": "Current Page",
            "doc": "Page currently visible in the viewer",
            "initialization_code": {
                "fn": "function(properties, context) {\n\n\n\n}"
            },
            "name": "current_page",
            "value": "number"
        },
        "ABI": {
            "caption": "Zoom Level (%)",
            "doc": "Current zoom level in percent",
            "initialization_code": {
                "fn": "function(properties, context) {\n\n\n\n}"
            },
            "name": "zoom_level",
            "value": "number"
        },
        "ABJ": {
            "caption": "Is Loading?",
            "doc": "true while the PDF is being downloaded and prepared",
            "initialization_code": {
                "fn": "function(properties, context) {\n\n\n\n}"
            },
            "name": "is_loading",
            "value": "boolean"
        },
        "ABK": {
            "caption": "Search Results Count",
            "doc": "Number of matches of the last search",
            "initialization_code": {
                "fn": "function(properties, context) {\n\n\n\n}"
            },
            "name": "search_results_count",
            "value": "number"
        },
        "ABL": {
            "caption": "PDF Title",
            "doc": "Title from the PDF metadata (may be empty)",
            "initialization_code": {
                "fn": "function(properties, context) {\n\n\n\n}"
            },
            "name": "pdf_title",
            "value": "text"
        },
        "ABM": {
            "caption": "PDF Author",
            "doc": "Author from the PDF metadata (may be empty)",
            "initialization_code": {
                "fn": "function(properties, context) {\n\n\n\n}"
            },
            "name": "pdf_author",
            "value": "text"
        },
        "ABN": {
            "caption": "Error Message",
            "doc": "Technical message of the last load/tool error (empty when none)",
            "initialization_code": {
                "fn": "function(properties, context) {\n\n\n\n}"
            },
            "name": "error_message",
            "value": "text"
        }
    },
    "events": {
        "ABO": {
            "caption": "PDF is loaded",
            "name": "pdf_loaded"
        },
        "ABP": {
            "caption": "PDF failed to load",
            "name": "pdf_error"
        },
        "ABQ": {
            "caption": "Page changed",
            "name": "page_changed"
        },
        "ABR": {
            "caption": "Search completed",
            "name": "search_completed"
        },
        "ABS": {
            "caption": "Download started",
            "name": "download_started"
        },
        "ABT": {
            "caption": "Print started",
            "name": "print_started"
        }
    }
}
