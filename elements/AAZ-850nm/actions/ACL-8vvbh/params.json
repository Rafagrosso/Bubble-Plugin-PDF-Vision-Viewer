{
    "caption": "Extract pages & download",
    "fields": {
        "ACU": {
            "caption": "Pages (e.g. 1-3,5)",
            "name": "pages_range",
            "value": "text",
            "rank": 0,
            "editor": "DynamicValue"
        },
        "ACV": {
            "caption": "File name",
            "name": "filename",
            "value": "text",
            "rank": 1,
            "editor": "DynamicValue",
            "optional": true
        }
    },
    "code": {
        "fn": "function(instance, properties, context) {\n    var pv = instance.data && instance.data.pv;\n    if (!pv) return;\n    pv.extractPages(properties.pages_range, properties.filename);\n}"
    }
}
